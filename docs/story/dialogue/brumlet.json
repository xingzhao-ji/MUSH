  "nodes": [
    {
      "id": "brumlet_meeting_open",
      "speaker": "brumlet",
      "kind": "meeting",
      "text": "I'm Brumlet. I came up from the Basalt Shore. This is a good landing. The stone holds a little of the day's warmth.",
      "conditions": [
        {
          "not_flag": "met_brumlet"
        }
      ],
      "effects": [
        {
          "set_flag": "met_brumlet",
          "value": true
        }
      ],
      "next": "brumlet_meeting_question"
    },
    {
      "id": "brumlet_meeting_question",
      "speaker": "brumlet",
      "kind": "meeting",
      "text": "I am looking for a place to sit and listen. What makes a place comfortable for you?",
      "conditions": [
        {
          "flag": "met_brumlet"
        }
      ],
      "effects": [],
      "choices": [
        {
          "text": "A little shelter.",
          "next": "brumlet_meeting_value_1"
        },
        {
          "text": "Something soft to sit on.",
          "next": "brumlet_meeting_value_2"
        },
        {
          "text": "Someone who is happy to be quiet.",
          "next": "brumlet_meeting_value_3"
        }
      ]
    },
    {
      "id": "brumlet_meeting_value_1",
      "speaker": "brumlet",
      "kind": "meeting",
      "text": "Yes. Enough to keep the wind from speaking directly into both ears.",
      "conditions": [
        {
          "flag": "met_brumlet"
        }
      ],
      "effects": [],
      "next": "brumlet_meeting_close"
    },
    {
      "id": "brumlet_meeting_value_2",
      "speaker": "brumlet",
      "kind": "meeting",
      "text": "I brought a felt liner for that. Basalt taught me to appreciate a small, portable softness.",
      "conditions": [
        {
          "flag": "met_brumlet"
        }
      ],
      "effects": [],
      "next": "brumlet_meeting_close"
    },
    {
      "id": "brumlet_meeting_value_3",
      "speaker": "brumlet",
      "kind": "meeting",
      "text": "I can do that. And I will not mind if you think of something to say.",
      "conditions": [
        {
          "flag": "met_brumlet"
        }
      ],
      "effects": [],
      "next": "brumlet_meeting_close"
    },
    {
      "id": "brumlet_meeting_close",
      "speaker": "brumlet",
      "kind": "meeting",
      "text": "You can find me near the quiet landing. You need not arrive quietly. I would like to know you are there.",
      "conditions": [
        {
          "flag": "met_brumlet"
        }
      ],
      "effects": []
    },
    {
