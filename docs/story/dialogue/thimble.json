          "value": true
        }
      ],
      "next": "thimble_relationship_trusted_reply"
    },
    {
      "id": "thimble_relationship_trusted_reply",
      "speaker": "thimble",
      "kind": "relationship",
      "text": "I still miss my old garden sometimes. I like that I can tell you without making this one any less lovely.",
      "conditions": [
        {
          "flag": "met_thimble"
        },
        {
          "flag": "trusted_thimble"
        }
      ]
    },
    {
      "id": "thimble_relationship_trusted_repeat",
      "speaker": "thimble",
      "kind": "relationship",
      "text": "There is something comforting about knowing you may choose differently. It means I get to see more than one garden.",
      "conditions": [
        {
          "flag": "met_thimble"
        },
        {
          "flag": "trusted_thimble"
        }
      ]
    },
    {
      "id": "thimble_festival_before",
      "speaker": "thimble",
      "kind": "festival",
      "text": "I could bring flowers to the gathering. Not all the same kind, perhaps. I am considering the very bold idea of asking what people like.",
