    {
      "id": "thimble_quest_after_detail",
      "speaker": "thimble",
      "kind": "quest",
      "text": "I left one envelope empty on purpose today. It is doing an excellent job of not deciding anything yet.",
      "conditions": [
        {
          "flag": "met_thimble"
        },
        {
          "flag": "q_thimble_done"
        }
