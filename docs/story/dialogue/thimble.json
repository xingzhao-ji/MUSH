    {
      "id": "thimble_relationship_friend_reply",
      "speaker": "thimble",
      "kind": "relationship",
      "text": "Perhaps tomorrow I will like a leaf I have passed a hundred times. I would like to tell you if I do.",
      "conditions": [
        {
          "flag": "met_thimble"
        },
        {
          "flag": "friend_thimble"
        }
      ]
    },
    {
      "id": "thimble_relationship_friend_repeat",
      "speaker": "thimble",
      "kind": "relationship",
      "text": "I have saved a place beside the seed tray for looking at things. It is also a good place for simply being nearby.",
      "conditions": [
        {
          "flag": "met_thimble"
        },
        {
          "flag": "friend_thimble"
        }
      ]
    },
    {
      "id": "thimble_relationship_trusted",
      "speaker": "thimble",
      "kind": "relationship",
      "text": "At the gathering, all those different little lights belonged together. Your garden helped me notice how that could happen.",
      "conditions": [
        {
          "flag": "met_thimble"
        },
        {
          "flag": "friend_thimble"
        },
        {
          "flag": "m_festival_done"
