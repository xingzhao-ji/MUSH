        {
          "flag": "met_copperleaf"
        },
        {
          "time": "day"
        },
        {
          "weather": "rain"
        }
      ],
      "effects": []
    },
    {
      "id": "copperleaf_greeting_dusk_clear",
      "speaker": "copperleaf",
      "kind": "greeting",
      "text": "The last light turns the leaf litter copper. I deny arranging it to match my name.",
