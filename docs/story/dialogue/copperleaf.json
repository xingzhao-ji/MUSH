      "effects": []
    },
    {
      "id": "copperleaf_greeting_night_clear",
      "speaker": "copperleaf",
      "kind": "greeting",
      "text": "The covered walk is quiet tonight. The rest mark can serve someone who merely wants to look at the lanterns.",
