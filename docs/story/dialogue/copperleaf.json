    {
      "id": "copperleaf_greeting_dusk_rain",
      "speaker": "copperleaf",
      "kind": "greeting",
      "text": "Dusk rain. I have a dry card and a slightly damp sleeve. A reasonable division of duties.",
      "conditions": [
        {
          "flag": "met_copperleaf"
        },
        {
          "time": "dusk"
        },
        {
          "weather": "rain"
        }
