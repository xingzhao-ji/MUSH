        {
          "flag": "met_copperleaf"
        },
        {
          "not_flag": "q_copperleaf_done"
        },
        {
          "not_flag": "q_copperleaf_accepted"
        }
      ],
      "effects": [],
      "choices": [
        {
          "text": "I'll walk it and show the resting place.",
          "next": "copperleaf_quest_accept"
        },
        {
          "text": "I'll leave the card with you for now.",
          "next": "copperleaf_quest_defer"
        }
      ]
    },
    {
