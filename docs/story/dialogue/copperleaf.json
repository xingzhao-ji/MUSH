        {
          "flag": "met_copperleaf"
        },
        {
          "time": "day"
        },
        {
          "weather": "clear"
        }
      ],
      "effects": []
    },
    {
      "id": "copperleaf_greeting_day_rain",
      "speaker": "copperleaf",
      "kind": "greeting",
      "text": "Stay under the cover if you like. Rain is much easier to admire from the side.",
