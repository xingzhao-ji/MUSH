    {
      "id": "quillip_quest_event_wait",
      "speaker": "quillip",
      "kind": "quest",
      "text": "After exploring the terrace sightline, mark one visited stopping place on the foldout. I have left the rest of the paper open.",
      "conditions": [
        {
          "flag": "met_quillip"
        },
        {
          "not_flag": "q_quillip_done"
