    {
      "id": "quillip_quest_ready",
      "speaker": "quillip",
      "kind": "quest",
      "text": "You explored the sightline and marked a stop. Look! The map now tells a walker where the journey can include a rest.",
      "conditions": [
        {
          "flag": "met_quillip"
        },
        {
          "not_flag": "q_quillip_done"
        },
        {
          "flag": "q_quillip_accepted"
