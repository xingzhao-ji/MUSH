          "flag": "q_quillip_prepared"
        },
        {
          "flag": "e_quillip_map"
        }
      ],
      "effects": [],
      "choices": [
        {
          "text": "Let's keep some space for the next discovery.",
          "next": "quillip_quest_complete"
        }
      ]
    },
    {
      "id": "quillip_quest_complete",
      "speaker": "quillip",
      "kind": "quest",
      "text": "Keep this foldout map as a memento. I have copied the stop and left a generous blank beside it. A deliberate blank!",
      "conditions": [
        {
          "flag": "met_quillip"
        },
        {
          "not_flag": "q_quillip_done"
        },
        {
          "flag": "q_quillip_accepted"
        },
        {
          "flag": "q_quillip_prepared"
